{
	"name": "n8n-nodes-appruvit",
	"version": "1.0.0",
	"description": "Send approval requests to AppruvIt and wait for approvers to decide on their phone, confirmed with a fingerprint, Face ID or Touch ID.",
	"license": "MIT",
	"homepage": "https://appruvit.com",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/versigear/n8n-nodes-appruvit.git"
	},
	"bugs": {
		"url": "https://github.com/versigear/n8n-nodes-appruvit/issues"
	},
	"keywords": [
		"n8n-community-node-package",
		"approval",
		"human-in-the-loop"
	],
	"author": {
		"name": "Versigear F.Z.C.",
		"email": "mail@versigear.com"
	},
	"scripts": {
		"prebuild": "node scripts/sync-brand.mjs",
		"build": "n8n-node build",
		"lint": "n8n-node lint",
		"lint:fix": "n8n-node lint --fix",
		"pretest": "node scripts/sync-brand.mjs --check",
		"test": "vitest run",
		"test:watch": "vitest"
	},
	"files": [
		"dist"
	],
	"n8n": {
		"n8nNodesApiVersion": 1,
		"strict": true,
		"credentials": [
			"dist/credentials/AppruvItApi.credentials.js"
		],
		"nodes": [
			"dist/nodes/AppruvIt/AppruvIt.node.js"
		]
	},
	"devDependencies": {
		"@n8n/node-cli": "0.51.5",
		"eslint": "9.32.0",
		"n8n-workflow": "2.30.0",
		"prettier": "3.6.2",
		"typescript": "5.9.2",
		"vitest": "3.2.4"
	},
	"peerDependencies": {
		"n8n-workflow": "*"
	}
}
